{
  "name": "@l77948032-cyber/dsh-workbuddy",
  "version": "1.0.0",
  "description": "以独立 Provider 为 DeepSeek Harness 接入 WorkBuddy API Key 或网页登录令牌",
  "author": "l77948032-cyber; based on Axiaohungry/dsh-llm-workbuddy",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "workbuddy",
    "llm",
    "provider"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-workbuddy": "cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l77948032-cyber/DSH-Workbuddy.git"
  },
  "homepage": "https://github.com/l77948032-cyber/DSH-Workbuddy#readme",
  "bugs": {
    "url": "https://github.com/l77948032-cyber/DSH-Workbuddy/issues"
  },
  "files": [
    "index.js",
    "workbuddy-auth.js",
    "workbuddy-credits.js",
    "workbuddy-web.js",
    "client.js",
    "cli.js",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check workbuddy-auth.js && node --check workbuddy-credits.js && node --check workbuddy-web.js && node --check client.js && node --check cli.js && node --test test.js && node cli.js --self-test"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1 <0.2.0"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "pnpm": "11.19.0",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": ">=0.1.5-rc.1 <0.2.0",
    "@deepseek-ai/dsh-launch-environment": ">=0.1.5-rc.1 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.1 <0.2.0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.5-rc.1 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.1.5-rc.1 <0.2.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.1",
    "@deepseek-ai/dsh-authorization": "0.1.5-rc.1",
    "@deepseek-ai/dsh-brand": "0.1.5-rc.1",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.1",
    "@deepseek-ai/dsh-fs": "0.1.5-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.5-rc.1",
    "@deepseek-ai/dsh-launch-environment": "0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.5-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.1.5-rc.1",
    "@deepseek-ai/dsh-scope": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "0.1.5-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.1",
    "@deepseek-ai/dsh-timeout": "0.1.5-rc.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "react": "18.3.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
